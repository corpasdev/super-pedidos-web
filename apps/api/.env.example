# Copia este archivo como .env y completa los valores (nunca subas el .env al repositorio).
PORT=3000
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Llave secreta de Supabase (Settings → API). Solo la usa la API; salta RLS.
SUPABASE_SECRET_KEY=<llave-secreta>
ALLOWED_WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
