# Copia este archivo como .env y completa los valores (nunca subas el .env al repositorio).
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Llave pública (anon) de Supabase: la web solo la usa para iniciar sesión.
VITE_SUPABASE_ANON_KEY=<llave-anon>
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Modo de prueba de Sugeridos (datos de data/mock, no guarda nada). También se activa con ?mock en la dirección.
VITE_MOCK=0
